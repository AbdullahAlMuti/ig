{
  "name": "feedsort-pro",
  "version": "2.4.0",
  "description": "Sort Instagram feed/reels/hashtag/search, analyze engagement rates, bulk download media, and export analytics to Excel. Modern MV3 rebuild.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "node scripts/prepare-icons.mjs",
    "build": "wxt build",
    "build:firefox": "node scripts/prepare-icons.mjs && wxt build -b firefox",
    "zip": "node scripts/prepare-icons.mjs && wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "node scripts/prepare-icons.mjs && wxt prepare"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "wxt": "^0.19.29"
  }
}
